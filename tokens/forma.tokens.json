  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "IBM Plex Sans",
        "system-ui",
        "Segoe UI",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "IBM Plex Mono",
        "ui-monospace",
        "Consolas",
        "monospace"
      ]
    },
    "num": {
      "$type": "fontFamily",
      "$value": [
        "ui-monospace",
        "SFMono-Regular",
        "Consolas",
        "monospace"
      ],
      "$extensions": {
        "fsa.usage": "Valeurs chiffrées des cartes de statistiques"
      }
    }
  },
  "typography": {
    "2xl": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "31px",
        "lineHeight": "1.15",
        "fontWeight": 600,
        "letterSpacing": "-0.02em"
      },
      "$extensions": {
        "fsa.usage": "Titre de vue principale"
      }
    },
    "xl": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "25px",
        "lineHeight": "1.2",
        "fontWeight": 600,
        "letterSpacing": "-0.015em"
      },
      "$extensions": {
        "fsa.usage": "Titre d'écran"
      }
    },
    "lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "20px",
        "lineHeight": "1.25",
        "fontWeight": 600,
        "letterSpacing": "-0.015em"
      },
      "$extensions": {
        "fsa.usage": "Titre de section"
      }
    },
    "base": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "15px",
        "lineHeight": "1.5",
        "fontWeight": 400,
        "letterSpacing": "0"
      },
      "$extensions": {
        "fsa.usage": "Texte courant"
      }
    },
    "sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "13px",
        "lineHeight": "1.4",
        "fontWeight": 400,
        "letterSpacing": "0"
      },
      "$extensions": {
        "fsa.usage": "Libellé, tableau dense"
      }
    },
    "xs": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "11.5px",
        "lineHeight": "1.45",
        "fontWeight": 400,
        "letterSpacing": "0"
      },
      "$extensions": {
        "fsa.usage": "Métadonnée"
      }
    },
    "mono": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.mono}",
        "fontSize": "13px",
        "lineHeight": "1.5",
        "fontWeight": 400,
        "letterSpacing": "0"
      },
      "$extensions": {
        "fsa.usage": "Identifiant contractuel"
      }
    }
  },
  "space": {
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "6": {
      "$type": "dimension",
      "$value": "24px"
    },
    "8": {
      "$type": "dimension",
      "$value": "32px"
    },
    "12": {
      "$type": "dimension",
      "$value": "48px"
    }
  },
  "radius": {
    "control": {
      "$type": "dimension",
      "$value": "3px",
      "$extensions": {
        "fsa.usage": "Bouton, champ, badge"
      }
    },
    "surface": {
      "$type": "dimension",
      "$value": "6px",
      "$extensions": {
        "fsa.usage": "Carte, panneau, overlay"
      }
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px",
      "$extensions": {
        "fsa.usage": "Pastille d'état en ligne"
      }
    }
  },
  "size": {
    "control": {
      "$type": "dimension",
      "$value": "34px",
      "$extensions": {
        "fsa.usage": "Hauteur de contrôle à densité 75"
      }
    }
  },
  "elevation": {
    "0": {
      "$type": "shadow",
      "$value": "none",
      "$extensions": {
        "fsa.usage": "Bord seul — défaut de la peau"
      }
    },
    "1": {
      "$type": "shadow",
      "$value": "none",
      "$extensions": {
        "fsa.usage": "Carte : aucune ombre, le bord suffit"
      }
    },
    "2": {
      "$type": "shadow",
      "$value": "0 6px 20px -8px rgba(22,22,20,.22)",
      "$extensions": {
        "fsa.usage": "Overlay uniquement",
        "fsa.dark": "0 10px 26px -10px rgba(0,0,0,.8)"
      }
    }
  }
}
